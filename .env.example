# ShiftPilot QSR Frontline Operations Agent - Environment Configuration
# Copy to .env for local development. NEVER commit .env or real keys.

# Google Gemini / Vertex AI credentials (resolved via Secret Manager in Cloud Run)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Google Cloud Project (required for Secret Manager, Firestore, Cloud DLP, Cloud Trace)
GCP_PROJECT_ID=shiftpilot-qsr-prod
GCP_REGION=us-central1

# Secret Manager secret names (used when running on GCP)
SECRET_NAME_GOOGLE_API_KEY=shiftpilot-google-api-key

# Model Routing Configuration
MODEL_FAST_LOOKUP=gemini-2.5-flash
MODEL_COMPLEX_REASONING=gemini-2.5-pro

# Persistence Backend: "sqlite" (local) or "firestore" (GCP)
MEMORY_BACKEND=sqlite
SQLITE_DB_PATH=.shiftpilot_data/shiftpilot_state.db
FIRESTORE_COLLECTION_PREFIX=shiftpilot

# Human-in-the-Loop (HITL) Approval Thresholds
HITL_MAINTENANCE_COST_THRESHOLD_USD=250.0
HITL_VOUCHER_AMOUNT_THRESHOLD_USD=25.0

# Observability & PII Redaction
LOG_LEVEL=INFO
ENABLE_CLOUD_DLP=false
OTEL_SERVICE_NAME=qsr-frontline-ops-agent
OTEL_EXPORTER_OTLP_ENDPOINT=

# History Compaction Settings
COMPACTION_WINDOW_TURNS=8
COMPACTION_MAX_TOKENS=6000
